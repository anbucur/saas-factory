{
  "name": "saas-factory",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:ui": "npm run dev --workspace=apps/factory-ui",
    "dev:backend": "npm run dev --workspace=apps/factory-backend",
    "test": "turbo test",
    "test:run": "turbo test:run"
  },
  "devDependencies": {
    "@types/opossum": "^8.1.9",
    "playwright": "^1.58.2",
    "puppeteer": "^24.40.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "opossum": "^9.0.0"
  }
}
