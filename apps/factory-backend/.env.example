# MiniMax LLM API Key (required for agent reasoning)
MINIMAX_API_KEY=your_minimax_api_key_here

# Backend server port (default: 3010)
PORT=3010

# Shrimp Task Manager MCP Configuration
# Path to the shrimp MCP server executable
SHRIMP_SERVER_PATH=C:\Users\alexa\.config\opencode\mcp-shrimp-task-manager\dist\index.js

# Directory where shrimp stores task data
SHRIMP_DATA_DIR=C:\Users\alexa\.config\opencode\shrimp-data

# Fallback mode when shrimp MCP is unavailable: fail | template | ask
SHRIMP_FALLBACK_MODE=ask

# Task complexity thresholds for PM approval
# Tasks with estimatedHours >= HIGH_COMPLEXITY_HOURS or subtasks >= HIGH_COMPLEXITY_SUBTASKS require PM approval
HIGH_COMPLEXITY_HOURS=8
HIGH_COMPLEXITY_SUBTASKS=3

# Verification passing threshold (0-100)
VERIFICATION_PASSING_SCORE=80

# Maximum verification retries before marking as failed
MAX_VERIFICATION_RETRIES=3
